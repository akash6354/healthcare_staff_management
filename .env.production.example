# Production settings for the VM (copy to /opt/oglos/.env.production, chmod 600). Never commit real values.
# Generate secrets:  python -c "import secrets;print(secrets.token_urlsafe(48))"
#                    python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENV=production
ADMIN_HOST=app.oglos.site
STAFF_HOST=ops.oglos.site
APP_BASE_URL=https://app.oglos.site
CORS_ORIGINS=https://app.oglos.site,https://ops.oglos.site
ACME_EMAIL=REPLACE-ops-contact@oglos.site

POSTGRES_SUPERUSER_PASSWORD=REPLACE
OGLOS_OWNER_PASSWORD=REPLACE
OGLOS_APP_PASSWORD=REPLACE
OGLOS_PLATFORM_PASSWORD=REPLACE

# AWS (ap-south-1). Use an instance role; leave keys empty so boto3 picks it up.
S3_ENDPOINT_URL=
S3_BUCKET=REPLACE-oglos-evidence-prod
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_ORIGIN=https://REPLACE-oglos-evidence-prod.s3.ap-south-1.amazonaws.com
EMAIL_PROVIDER=ses
EMAIL_FROM=OGLOS <no-reply@oglos.site>
AWS_SES_REGION=ap-south-1

JWT_SIGNING_KEY=REPLACE
FIELD_ENCRYPTION_KEYS=v1:REPLACE_BASE64_32_BYTES
FIELD_ENCRYPTION_ACTIVE_KEY=v1
HMAC_LOOKUP_KEY=REPLACE
QR_SIGNING_KEYS=v1:REPLACE
OTP_HMAC_KEY=REPLACE
BREACHED_PASSWORD_CHECK=hibp

# Backups (infra/backup/backup.sh): second Indian region, 30-day lifecycle
BACKUP_BUCKET=REPLACE-oglos-backups
BACKUP_REGION=ap-south-2
AGE_RECIPIENT=REPLACE-age1...
