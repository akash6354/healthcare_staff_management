# Copy to .env for local development. Never commit .env.
# ---- Postgres (docker compose) ----
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
OGLOS_OWNER_PASSWORD=change-me-owner
OGLOS_APP_PASSWORD=change-me-app
OGLOS_PLATFORM_PASSWORD=change-me-platform
# Host port 5434 avoids clashing with other local Postgres instances (5432, 5433)
DATABASE_URL=postgresql+asyncpg://oglos_app:change-me-app@localhost:5434/oglos
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://oglos_owner:change-me-owner@localhost:5434/oglos
PLATFORM_DATABASE_URL=postgresql+asyncpg://oglos_platform:change-me-platform@localhost:5434/oglos
TEST_DATABASE_NAME=oglos_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (SeaweedFS locally, AWS S3 in prod) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=oglos-evidence
S3_ACCESS_KEY=oglos-local
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=ap-south-1
# Origin browsers load signed photo URLs from (CSP img-src), e.g. https://oglos-evidence.s3.ap-south-1.amazonaws.com
S3_PUBLIC_ORIGIN=http://localhost:9000

# ---- App ----
APP_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# 32-byte base64 keys: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
FIELD_ENCRYPTION_ACTIVE_KEY=v1
HMAC_LOOKUP_KEY=dev-only-change-me
QR_SIGNING_KEYS=v1:dev-only-change-me
OTP_HMAC_KEY=dev-only-change-me

# ---- Email (console | ses) ----
EMAIL_PROVIDER=console
EMAIL_FROM=OGLOS <no-reply@oglos.site>
AWS_SES_REGION=ap-south-1

# ---- Breached-password check (hibp | off) ----
BREACHED_PASSWORD_CHECK=off
