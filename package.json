{
  "name": "oglos-hoap",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @oglos/web-admin dev",
    "dev:pwa": "pnpm --filter @oglos/staff-pwa dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "typescript": "5.6.3",
    "vitest": "^4.1.12",
    "@playwright/test": "^1.55.1"
  },
  "type": "module"
}
