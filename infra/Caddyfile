# Local reverse proxy. Production adds the real domain (app.oglos.site) for automatic HTTPS.
:80 {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		-Server
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		respond "OGLOS web apps are served by Vite in development." 200
	}
}
